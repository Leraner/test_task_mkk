# PostgreSQL: читает и контейнер database (создаёт пользователя и БД),
# и сервисы приложения - api, migrations, outbox-relay, consumer (DBSettings)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payments
POSTGRES_HOST=database
POSTGRES_PORT=5432

# RabbitMQ: DEFAULT_USER/DEFAULT_PASS читает и контейнер rabbitmq (создаёт пользователя),
# и сервисы приложения (RabbitSettings)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Outbox relay (OutboxRelaySettings): размер пачки, пауза в секундах, когда отправлять нечего,
# и потолок паузы при ошибках подряд (пауза удваивается от POLL_INTERVAL)
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_MAX_BACKOFF=30.0

# Топология платежей (PaymentsQueuesSettings): exchange, очередь новых платежей, её DLQ,
# префикс retry-очередей, число попыток доставить webhook (после последней - DLQ)
# и задержка первого повтора в мс (дальше x2).
# Задержки вшиты в TTL retry-очередей - после их изменения удалить retry-очереди в RabbitMQ.
PAYMENTS_EXCHANGE=payments
PAYMENTS_NEW_QUEUE=payments.new
PAYMENTS_NEW_DLQ=payments.new.dlq
PAYMENTS_NEW_RETRY_QUEUE_PREFIX=payments.new.retry
PAYMENTS_MAX_ATTEMPTS=3
PAYMENTS_RETRY_BASE_DELAY_MS=2000

# Webhook (WebhookSettings): таймаут одного запроса в секундах
WEBHOOK_TIMEOUT=5.0

# Consumer (ConsumerSettings): сколько сообщений в обработке одновременно (prefetch);
# сколько секунд повторять сообщение при недоступной БД, потом nack и повтор с начала;
# потолок паузы между повторами в секундах
CONSUMER_PREFETCH_COUNT=100
CONSUMER_TRANSIENT_RETRY_FOR=60.0
CONSUMER_TRANSIENT_RETRY_MAX_DELAY=10.0
