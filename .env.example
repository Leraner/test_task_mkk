# PostgreSQL: владелец БД (контейнер database и миграции) и роль приложения с правами
# только на DML (api, outbox-relay, consumer). Роль приложения создаётся при инициализации
# пустого тома - после смены её логина или пароля том нужно пересоздать.
POSTGRES_DB=payments
POSTGRES_USER=payments_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_APP_USER=payments_app
POSTGRES_APP_PASSWORD=change-me-app

# RabbitMQ: пользователя создаёт контейнер rabbitmq, им же подключаются сервисы приложения
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=change-me-rabbit

# Статический ключ API: заголовок X-API-Key на всех эндпоинтах /api/v1
API_KEY=change-me-api-key

# Дальше - необязательные настройки, пустое или отсутствующее значение - значение по умолчанию.

# Outbox relay (OutboxRelaySettings): размер пачки, пауза в секундах, когда отправлять нечего,
# и потолок паузы при ошибках подряд (пауза удваивается от POLL_INTERVAL)
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_MAX_BACKOFF=30.0

# Топология платежей (PaymentsQueuesSettings): exchange, очередь новых платежей, её DLQ,
# префикс retry-очередей, число попыток доставить webhook включая первую (retry-очередей
# на одну меньше, после последней попытки - DLQ)
# и задержка первого повтора в мс (дальше x2).
# Задержки вшиты в TTL retry-очередей - после их изменения удалить retry-очереди в RabbitMQ.
PAYMENTS_EXCHANGE=payments
PAYMENTS_NEW_QUEUE=payments.new
PAYMENTS_NEW_DLQ=payments.new.dlq
PAYMENTS_NEW_RETRY_QUEUE_PREFIX=payments.new.retry
PAYMENTS_MAX_ATTEMPTS=4
PAYMENTS_RETRY_BASE_DELAY_MS=2000

# Webhook (WebhookSettings): таймаут одного запроса в секундах; отправка на приватные адреса
# (защита от SSRF) - true только для локальных тестов с приёмником во внутренней сети
WEBHOOK_TIMEOUT=5.0
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# Consumer (ConsumerSettings): сколько сообщений в обработке одновременно (prefetch);
# сколько секунд повторять сообщение при недоступной БД, потом nack и повтор с начала;
# потолок паузы между повторами в секундах
CONSUMER_PREFETCH_COUNT=100
CONSUMER_TRANSIENT_RETRY_FOR=60.0
CONSUMER_TRANSIENT_RETRY_MAX_DELAY=10.0
